{
  "name": "apogee",
  "version": "0.1.0",
  "private": true,
  "description": "Apogee - 本地优先、启动即用的桌面 API 客户端",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leo-Lee-j/apogee.git"
  },
  "bugs": {
    "url": "https://github.com/Leo-Lee-j/apogee/issues"
  },
  "homepage": "https://github.com/Leo-Lee-j/apogee#readme",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:nocheck": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pwsh -NoProfile -File scripts/test-e2e-windows.ps1",
    "tauri": "tauri",
    "spike:s1": "pwsh -NoProfile -File scripts/measure-s1-windows.ps1 -Runs 20",
    "spike:s1:nobuild": "pwsh -NoProfile -File scripts/measure-s1-windows.ps1 -Runs 20 -SkipBuild",
    "spike:s3": "pwsh -NoProfile -File scripts/measure-s3-windows.ps1",
    "spike:s3:nobuild": "pwsh -NoProfile -File scripts/measure-s3-windows.ps1 -SkipBuild",
    "spike:s5": "vite build --mode production && node scripts/measure-bundle.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "licenses:rust": "cargo about generate about.hbs -o THIRD-PARTY-NOTICES.txt",
    "licenses:npm": "node scripts/check-npm-licenses.mjs --notices",
    "licenses:check": "cargo deny check && node scripts/check-npm-licenses.mjs",
    "generate:sbom": "pnpm sbom --sbom-format spdx --prod --lockfile-only --out apogee-npm.spdx.json && node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@vicons/ionicons5": "^0.13.0",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "2.44.1",
    "pinia": "4.0.2",
    "sortablejs": "^1.15.7",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "6.0.8",
    "gzip-size": "7.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.8"
  }
}
