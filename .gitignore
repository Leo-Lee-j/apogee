# ── 构建产物 ─────────────────────────────────────────────────────────
/target
/dist
/node_modules
/.pnpm-store
/src-tauri/gen
/src-tauri/target

# ── 自动生成，不入库 ─────────────────────────────────────────────────
# unplugin-vue-components / unplugin-auto-import 生成的类型声明
/src/types/components.d.ts
/src/types/auto-imports.d.ts
# ts-rs 从 Rust 类型生成的 TS 定义（03 文档 §9「类型契约」）
/src/types/generated
# cargo-about / npm 归属声明和 SPDX SBOM 都由发布流程生成；不需要入库 ——
# 入库反而会每次依赖变动都产生噪声 diff。
/THIRD-PARTY-NOTICES.txt
/THIRD-PARTY-NOTICES-NPM.txt
/apogee-rust.spdx.json
/apogee-npm.spdx.json
# vite 分包归属 dump（调试用）
/dist/chunk-map.json

# ── Spike 中间产物 ───────────────────────────────────────────────────
# 报告本身要入库（是决策依据），但语料库和控制台原始输出不入库
/spikes/s6-postman-schema/corpus/
/spikes/results/*-console.txt

# ── 用户数据与密钥（PRD §10.2）─────────────────────────────────────
# 集合文件里的敏感值走 *.local.yaml，永不入库
*.local.yaml
*.local.json
.env
.env.*
!.env.example
/.apogee/

# ── 编辑器与系统 ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# AI 工作目录
.claude
.omc
